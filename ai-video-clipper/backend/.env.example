# Copy to .env and fill in. All settings are optional except where noted.

# Claude: clip selection, scoring, hooks and captions. Without it, a rule-based fallback is used.
ANTHROPIC_API_KEY=
CLIPPER_LLM_MODEL=claude-opus-5-5
CLIPPER_LLM_EFFORT=high

# Database (SQLite by default)
# CLIPPER_DATABASE_URL=postgresql+psycopg://clipper:clipper@localhost:5432/clipper
CLIPPER_DATA_DIR=./data

# Transcription (faster-whisper downloads the model on first use)
CLIPPER_WHISPER_MODEL=small
# CLIPPER_WHISPER_DEVICE=cuda
# CLIPPER_WHISPER_COMPUTE_TYPE=float16

# Background jobs: in-process by default; set both for Celery + Redis
# CLIPPER_USE_CELERY=true
# CLIPPER_REDIS_URL=redis://localhost:6379/0

# Storage: local by default; S3-compatible for production
# CLIPPER_STORAGE_BACKEND=s3
# CLIPPER_S3_BUCKET=clipper
# CLIPPER_S3_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

CLIPPER_CORS_ORIGINS=["http://localhost:3000"]
